    <path
        android:fillColor="#E0922F"
        android:fillType="evenOdd"
        android:pathData="M108.3,99.5 L122.9,99.5 C130.3,99.5 135.4,103.9 135.4,111.2 C135.4,116.8 132.2,120.9 127.0,122.3 L136.1,140.5 L128.2,140.5 L120.0,123.5 L115.6,123.5 L115.6,140.5 L108.3,140.5 Z M115.6,105.3 L115.6,117.9 L122.3,117.9 C126.2,117.9 128.1,115.6 128.1,111.6 C128.1,107.7 126.2,105.3 122.3,105.3 Z"/>
